  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\xC5ret er 1896. \nDu hedder Agnes, du er 6 \xE5r gammel og du er lige
    startet i skole. \n\nDu bor i en middelklassefamilie med dine for\xE6ldre og
    9 s\xF8skende. Din far arbejder lange dage p\xE5 fabrikken \u2013 hele 16 timer
    ad gangen. N\xE5r arbejdet endelig er slut, plejer han at tage forbi v\xE6rtshuset
    for at drikke pengene op, inden han kommer hjem. Din mor arbejder som syerske.
    Det er ikke et arbejde, man tjener meget p\xE5, men hun slider hver dag for at
    f\xE5 pengene til at r\xE6kke. Som barn er du ogs\xE5 med til at tjene penge
    til husstanden gennem h\xE5rdt arbejde. \n\nLige nu er du alene hjemme med din
    mor. Rummet er stille. Noget fanger din opm\xE6rksomhed: P\xE5 bordet ligger
    et stykke papir, som du ikke har set f\xF8r. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 3f3584ed3cf29430bad3c19f14ade5ef, type: 2}
